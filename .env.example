# ============================================================================
# WSaler — Environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in your own Supabase
# project credentials. Never commit the real `.env` file — it's gitignored.
#
# Where to find these values:
#   Supabase Dashboard -> your project -> Project Settings -> API
#     - "Project URL"       -> VITE_SUPABASE_URL
#     - "anon" public key   -> VITE_SUPABASE_ANON_KEY
#
# Vite only exposes env vars prefixed with VITE_ to client-side code, and
# only the ANON key should ever be used in the browser — never the
# service_role key (that one bypasses RLS entirely).
# ============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
